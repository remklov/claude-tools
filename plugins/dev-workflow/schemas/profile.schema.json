{
  "$comment": "dev-workflow project profile (.claude/workflow/profile.json). Validated by cw with a JSON-schema subset.",
  "type": "object",
  "required": [
    "version",
    "project",
    "packs",
    "packages",
    "git"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string"
            },
            "productCopy": {
              "type": "string"
            }
          }
        }
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              },
              "variant": {
                "type": "string"
              },
              "options": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "areas"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "path": {
            "type": [
              "string",
              "array"
            ]
          },
          "areas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "docs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclusive": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alsoCheck": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test": {
            "type": "object",
            "properties": {
              "single": {
                "type": "string"
              },
              "nameFlag": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "check"
        ],
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "stop": {
            "type": "string"
          },
          "stopIfStarted": {
            "type": "boolean"
          }
        }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "escalate": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "min"
            ],
            "additionalProperties": false,
            "properties": {
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "min": {
                "enum": [
                  "s",
                  "m",
                  "l",
                  "xl"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "builds-on",
            "parallel",
            "none"
          ]
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "threshold": {
          "enum": [
            "s",
            "m",
            "l",
            "xl"
          ]
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "worktree",
            "in-place"
          ]
        },
        "protectedCheckout": {
          "type": "string"
        },
        "appRoot": {
          "type": "string"
        },
        "symlink": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ports": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "devServer": {
          "enum": [
            "never",
            "allowed"
          ]
        }
      }
    },
    "git": {
      "type": "object",
      "required": [
        "branch",
        "commitSummary"
      ],
      "additionalProperties": false,
      "properties": {
        "host": {
          "enum": [
            "github",
            "gitlab",
            "none"
          ]
        },
        "defaultBase": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "branchNoTicket": {
          "type": "string"
        },
        "branchTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commitSummary": {
          "type": "string"
        },
        "commitSummaryNoTicket": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commitTrailers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summaryMax": {
          "type": "integer",
          "minimum": 20
        },
        "summaryIdeal": {
          "type": "integer"
        },
        "bodyWrap": {
          "type": "integer",
          "minimum": 40
        },
        "noTicketKey": {
          "type": "string"
        },
        "pr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "source": {
                    "enum": [
                      "spec.summary",
                      "classify.packages",
                      "checks",
                      "manualTests",
                      "migrations",
                      "deployImpact",
                      "openPoints",
                      "screenshots"
                    ]
                  }
                }
              }
            },
            "neverMerge": {
              "type": "boolean"
            },
            "draft": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "tickets": {
      "type": "object",
      "required": [
        "adapter"
      ],
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "markdown-table",
            "github-issues",
            "none"
          ]
        },
        "file": {
          "type": "string"
        },
        "idPattern": {
          "type": "string"
        },
        "columns": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        },
        "statusOpen": {
          "type": "string"
        },
        "dependsColumn": {
          "type": "string"
        },
        "deleteRowWhenDone": {
          "type": "boolean"
        },
        "newRowSections": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": {
              "enum": [
                "git-ref",
                "local"
              ]
            },
            "remote": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "idNamespace": {
              "type": "string"
            },
            "staleHours": {
              "type": "number"
            },
            "mergeDriver": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "knowledgeBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "string"
        },
        "lessons": {
          "type": "string"
        },
        "manualTests": {
          "type": "string"
        },
        "adr": {
          "type": "string"
        },
        "todo": {
          "type": "string"
        },
        "docsOnlyPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "neverGuess": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxReviewRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "confirm": {
          "type": "array",
          "items": {
            "enum": [
              "s",
              "m",
              "l",
              "xl"
            ]
          }
        },
        "maxQuestionsPerRound": {
          "type": "integer",
          "minimum": 1
        },
        "checkTimeoutMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "agentPrefix": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "override": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extend": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "allowProtected": {
          "type": "boolean"
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "array"
            ]
          }
        }
      }
    }
  }
}
