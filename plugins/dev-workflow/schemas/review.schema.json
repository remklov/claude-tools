{
  "title": "Reviewer result piped to cw review save (docs/PLAN.md §6 R8); cw adds the checks, recheck and rule facts and saves review-<round>.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "acceptanceCriteria", "rulesChecked", "findings"],
  "properties": {
    "status": { "enum": ["approved", "changes_requested"] },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "met", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC[1-9][0-9]*$" },
          "met": { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rulesChecked": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "rule", "issue"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[1-9][0-9]*$" },
          "severity": { "enum": ["blocking", "non_blocking"] },
          "rule": { "type": "string", "pattern": "^(spec|scope|git|correctness|security|[A-Z][A-Z0-9]*(-[A-Z0-9]+)+)$" },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "issue": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string" },
          "sendAlong": { "type": "boolean" }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
