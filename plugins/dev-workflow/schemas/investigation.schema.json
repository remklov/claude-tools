{
  "$comment": "Investigator result saved by cw investigation save (spec 01 §10).",
  "type": "object",
  "required": ["kind", "version", "task", "question", "findings", "recommendation"],
  "properties": {
    "kind": { "const": "investigation" },
    "version": { "const": 1 },
    "task": { "type": "string" },
    "question": { "type": "string" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "evidence", "basis"],
        "properties": { "claim": { "type": "string" }, "evidence": { "type": "string" }, "basis": { "enum": ["traced", "reasoned"] } }
      }
    },
    "rootCause": { "type": ["string", "null"] },
    "options": { "type": "array" },
    "recommendation": { "type": "string" },
    "briefAdditions": { "type": "string" }
  }
}
