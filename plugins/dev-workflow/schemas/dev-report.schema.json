{
  "title": "Implementer report piped to cw report save (docs/PLAN.md §6 step 8); cw adds the git, checks and proof facts and saves report-<round>.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "acceptanceCriteria", "handover"],
  "properties": {
    "status": { "enum": ["done", "blocked", "misclassified"] },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "met", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC[1-9][0-9]*$" },
          "met": { "type": "boolean" },
          "evidence": { "type": "string" }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "openPoints": {
      "type": "array",
      "items": {
        "description": "a text, or { text, tag? } with tag manual|follow-up|risk|question",
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "tag": { "enum": ["manual", "follow-up", "risk", "question"] }
            }
          }
        ]
      }
    },
    "handover": {
      "description": "what a fresh implementer needs to take the task over without exploring it again (docs/adr/0012): every key is required; a list may be empty and holds at most 8 short notes",
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions", "rejected", "testing", "pitfalls", "deviations"],
      "properties": {
        "decisions": { "description": "deliberate decisions and why", "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "rejected": { "description": "approaches tried or considered and dropped, and why", "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "testing": { "description": "the test commands and setups the work needs", "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "pitfalls": { "description": "known traps in the code or the tools", "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "deviations": { "description": "where the work deviates from the spec or a rule, and why", "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 400 } }
      }
    },
    "blocked": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["question", "needed"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "needed": { "type": "string", "minLength": 1 }
      }
    },
    "misclassified": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "suggested"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "suggested": { "enum": ["s", "m", "l", "xl"] }
      }
    }
  }
}
