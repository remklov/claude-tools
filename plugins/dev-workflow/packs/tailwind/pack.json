{
  "id": "tailwind",
  "version": "0.1.0",
  "title": "Tailwind CSS with a design system",
  "detect": [{ "dependency": "tailwindcss" }],
  "areas": ["frontend"],
  "options": {
    "designDoc": { "type": "string", "default": "the design documentation", "description": "Where tokens and patterns are documented" },
    "uiKit": { "type": "string", "default": "the existing UI components", "description": "Directory of the UI kit" },
    "globalCss": { "type": "string", "default": "the global stylesheet", "description": "Global stylesheet that must not grow" }
  },
  "rules": "rules.md"
}
