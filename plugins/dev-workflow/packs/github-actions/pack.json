{
  "id": "github-actions",
  "version": "0.1.0",
  "title": "GitHub Actions",
  "detect": [{ "glob": ".github/workflows/*.y*ml" }],
  "areas": ["infra"],
  "options": {
    "actionPinning": { "type": "string", "default": "tag", "description": "tag (full version tag) or sha" }
  },
  "rules": "rules.md",
  "playbooks": {
    "implementer": ["playbooks/implementer/workflow-change.md"],
    "orchestrator": ["playbooks/orchestrator/deploy-impact.md"]
  },
  "scripts": { "deploy-impact": "scripts/deploy-impact.mjs" }
}
