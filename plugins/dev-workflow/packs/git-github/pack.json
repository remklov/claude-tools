{
  "id": "git-github",
  "version": "0.1.0",
  "title": "GitHub pull requests with gh",
  "detect": [{ "remote": "github\\.com" }],
  "playbooks": { "orchestrator": ["playbooks/orchestrator/github-pr.md"] },
  "doctor": [{ "id": "gh", "script": "scripts/doctor-gh.mjs", "description": "gh installed and logged in to github.com" }],
  "scripts": { "pr-exists": "scripts/pr-exists.mjs" },
  "settings": {
    "allow": ["Bash(gh auth status *)", "Bash(gh pr view *)", "Bash(gh pr list *)"],
    "ask": ["Bash(gh pr create *)", "Bash(gh pr merge *)"]
  }
}
