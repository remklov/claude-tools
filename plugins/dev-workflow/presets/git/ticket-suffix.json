{
  "id": "ticket-suffix",
  "branch": "{ticketLower}-{slug}",
  "branchNoTicket": "chore-{slug}",
  "types": ["feature", "bugfix", "hotfix"],
  "slug": "^[a-z0-9]+(-[a-z0-9]+){1,3}$",
  "noTicketKey": "NO-TICKET",
  "commit": {
    "summary": "{text} ({ticket})",
    "summaryNoTicket": "{text}",
    "keywords": [],
    "flags": [],
    "summaryMax": 72,
    "summaryIdeal": 52,
    "bodyWrap": 72,
    "trailers": []
  },
  "pr": {
    "sections": ["What & why", "Affected packages", "Testing", "Risks & deploy steps", "Open points", "Screenshots"],
    "trailers": [],
    "neverMerge": true
  }
}
