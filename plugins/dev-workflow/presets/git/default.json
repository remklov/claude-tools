{
  "id": "default",
  "branch": "{ticket}/{type}/{slug}",
  "types": ["feature", "bugfix", "hotfix"],
  "slug": "^[a-z0-9]+(-[a-z0-9]+){1,3}$",
  "noTicketKey": "maintenance",
  "commit": {
    "keywords": ["FEATURE", "BUGFIX", "TASK", "DOCS"],
    "flags": ["!!!", "SECURITY"],
    "summaryMax": 72,
    "summaryIdeal": 52,
    "bodyWrap": 72,
    "trailers": ["Relates to {ticket}"]
  },
  "pr": {
    "sections": ["What & why", "Testing", "Risks & deploy steps", "Open points"],
    "trailers": ["Relates to {ticket}"],
    "neverMerge": true
  }
}
